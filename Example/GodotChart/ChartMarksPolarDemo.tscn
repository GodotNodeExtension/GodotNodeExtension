[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Example/GodotChart/ChartMarksPolarDemo.cs" id="1_demo"]
[ext_resource type="Script" path="res://Component/GodotChart/ChartView.cs" id="2_chart"]

[node name="ChartMarksPolarDemo" type="MarginContainer" node_paths=PackedStringArray("PieChart", "DonutTextChart", "DonutRichChart", "GaugeChart", "GaugeRingChart", "RadarChart", "RadarGridlessChart", "FunnelChart")]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8
script = ExtResource("1_demo")
PieChart = NodePath("Layout/Grid/Pie/PieChart")
DonutTextChart = NodePath("Layout/Grid/DonutText/DonutTextChart")
DonutRichChart = NodePath("Layout/Grid/DonutRich/DonutRichChart")
GaugeChart = NodePath("Layout/Grid/Gauge/GaugeChart")
GaugeRingChart = NodePath("Layout/Grid/GaugeRing/GaugeRingChart")
RadarChart = NodePath("Layout/Grid/Radar/RadarChart")
RadarGridlessChart = NodePath("Layout/Grid/RadarGridless/RadarGridlessChart")
FunnelChart = NodePath("Layout/Grid/Funnel/FunnelChart")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="RichTextLabel" parent="Layout"]
layout_mode = 2
custom_minimum_size = Vector2(1, 0)
autowrap_mode = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "[b][font_size=19]Polar mark knobs[/font_size][/b]\n[color=#93a1b5]Pie, donut, gauge, radar and funnel, each one ChartView configured through view.ConfigureMark(...). These marks draw from the plot's short edge, so the cell is what sizes them: every cell sets [code]PlotAspectRatio = 1[/code] (a square content box) - and [code]PlotAlignHorizontal[/code] decides whether that box sits left, centre or right in the cell (the Pie and Donut·rich center cells show left and right). Cartesian / hierarchy knobs: ChartMarksCartesianDemo / ChartMarksHierarchyDemo.[/color]"

[node name="HeaderRule" type="HSeparator" parent="Layout"]
layout_mode = 2

[node name="Grid" type="GridContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 16
columns = 2

