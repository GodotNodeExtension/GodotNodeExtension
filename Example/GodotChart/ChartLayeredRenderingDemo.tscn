[node name="Header" type="RichTextLabel" parent="Layout/Column"]
layout_mode = 2
custom_minimum_size = Vector2(1, 0)
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
text = "[b][font_size=19]Layered rendering, measured[/font_size][/b]\n[color=#93a1b5]One table, one [b]LineMark[/b], two hand-built [code]Chart[/code] instances: the left draws every frame in a single pass, the right keeps its data layer in an image ([code]LayeredRendering = true[/code] on the canvas, [code]Chart.UseLayerCache[/code] on the chart) and repaints the overlay alone - both timed with the same rows. A frame that has to draw the layer again does the same drawing on both sides, so it is the one frame the cache cannot win (the right one even adds a surface readback); the gain is in the frames that only move the pointer, which is what [b]H[/b] measures.[/color]"

