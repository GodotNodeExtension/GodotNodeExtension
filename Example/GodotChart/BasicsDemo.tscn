[node name="Header" type="Label" parent="Layout" unique_id=892339675]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
text = "Basics - every chart kind the library ships, one cell at least each (bar fills four of them and area two, as variants of one kind), and every mark of the library is shown here, the reference-line mark included. Each cell is a ChartView node: its Kind, Rows (typed key/value dictionaries) and channel fields are set right here in the scene, so you can copy one and edit it. Knobs that need code live in the three mark-knob pages, and data transforms (a histogram, for instance) in the custom-charts page."
autowrap_mode = 3

