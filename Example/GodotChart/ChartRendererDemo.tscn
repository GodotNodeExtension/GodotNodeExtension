[node name="Notes" type="VBoxContainer" parent="Layout/Grid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Caption" type="RichTextLabel" parent="Layout/Grid/Notes"]
layout_mode = 2
