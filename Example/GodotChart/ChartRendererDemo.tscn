bbcode_enabled = true
fit_content = true
scroll_active = false
text = "[b]Where to go next[/b] · [b]ChartCustomizationDemo[/b] builds the marks and encodings these slots draw, [b]ChartCanvasDemo[/b] runs the pointer loop and the queries, [b]ChartScaleDemo[/b] covers the scales."
