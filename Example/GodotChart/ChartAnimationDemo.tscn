text = "[b][font_size=19]Host-driven animation[/font_size][/b]\n[color=#93a1b5]The controller owns the tweens; every frame the script feeds AnimationContext to chart.Animate(ctx) + Repaint(). Buttons: entry / hover / data / exit.[/color]"

